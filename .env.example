# Copy to .env.local and fill in. Never commit .env.local.
# No LLM key needed: briefs are generated by the OpenServ platform runtime.

# Optional escape hatch: paste the webhook URL the agent prints on startup.
# Normally not needed: the API reads agent/.openserv.json automatically.
# OPENSERV_WEBHOOK_URL=https://api.openserv.ai/webhooks/trigger/...

# Payments (Kite testnet, chain id 2368)
SELLER_ADDRESS=0xYourSellerWalletHere
BRIEF_PRICE_KITE=0.01
KITE_RPC_URL=https://rpc-testnet.gokite.ai
KITE_EXPLORER_URL=https://testnet.kitescan.ai

# Optional: direct brief fallback via OpenRouter (free tier works).
# The app tries AgentRouter, then this, then Pollinations free fallback.
# OPENAI_BASE_URL=https://openrouter.ai/api/v1
# OPENAI_API_KEY=sk-or-v1-paste-friends-key-here
# OPENAI_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
